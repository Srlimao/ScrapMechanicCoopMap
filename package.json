{
  "name": "scrap-mechanic-tactical-map",
  "version": "1.6.0",
  "description": "Scrap Mechanic Tactical Save Map Viewer & Real-Time Player Tracker",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "vite build && electron-builder",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:linux": "vite build && electron-builder --linux AppImage",
    "test:e2e": "npx tsx ../test-harness/runners/mock-e2e.ts",
    "test:live": "npx tsx ../test-harness/runners/live-runner.ts",
    "test:responsive": "node scripts/test-responsive.js",
    "test": "npm run test:e2e"
  },
  "keywords": [
    "scrap-mechanic",
    "map-viewer",
    "save-game",
    "live-tracker",
    "electron"
  ],
  "author": "Scrap Mechanic Tactical Map Team",
  "license": "MIT",
  "build": {
    "appId": "com.scrapmechanic.tacticalmap",
    "productName": "Scrap Mechanic Tactical Map",
    "directories": {
      "output": "dist_release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "server.py",
      "backend/**/*",
      "terrain_builder.py",
      "extract_save.py",
      "*.py"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "server.py",
      "terrain_builder.py",
      "extract_save.py",
      "asset_uuids.json",
      "survival-world-surface.webp",
      "terrain-cell-atlas.webp",
      "terrain-cell-atlas.json",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": "portable",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Scrap-Mechanic-Tactical-Map.exe"
    },
    "linux": {
      "icon": "electron/icon.png",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "sql.js": "^1.12.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "koffi": "^3.1.5"
  }
}
